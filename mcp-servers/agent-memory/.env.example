# Path to Obsidian Vault directory (defaults to ./obsidian)
OBSIDIAN_VAULT=./obsidian

# Optional: Path to SQLite memory cache database
# MEMORY_DB=./obsidian/.agent-memory/index.db

# Log level: debug | info | warn | error
MEMORY_LOG_LEVEL=info

# Embeddings mode: disabled | local
MEMORY_EMBEDDINGS=disabled
