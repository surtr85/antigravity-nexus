.agent-memory/*.db-shm

# Temporary files & OS metadata
.tmp-*
.DS_Store
Thumbs.db

# Obsidian ephemeral workspace, graph & cache state
**/.obsidian/workspace*.json
**/.obsidian/graph.json
**/.obsidian/cache/
**/.obsidian/backups/
