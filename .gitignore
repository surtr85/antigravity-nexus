# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# SQLite runtime cache databases (rebuilt automatically from markdown notes)
*.db
*.db-journal
*.db-wal
*.db-shm
.agent-memory/*.db
.agent-memory/*.db-wal
.agent-memory/*.db-shm

# Temporary files & OS metadata
.tmp-*
.DS_Store
Thumbs.db

# Obsidian ephemeral workspace, graph & cache state
**/.obsidian/workspace*.json
**/.obsidian/graph.json
**/.obsidian/cache/
**/.obsidian/backups/
