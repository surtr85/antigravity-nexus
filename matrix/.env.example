# Matrix Homeserver & Bot Credentials
MATRIX_HOMESERVER=https://matrix.example.com
MATRIX_USERNAME=your_bot_username
MATRIX_PASSWORD=your_bot_password

# Access Control: Comma-separated list of authorized Matrix User IDs
# Only users in this list can invite the bot, execute commands, or send prompts.
# Leave empty or set to '*' to allow all users (not recommended for production).
MATRIX_ALLOWED_USERS=@your_username:matrix.example.com

# Optional: Matrix Recovery Key for Automated Cross-Signing & SSSS Self-Verification
# When set, the bot automatically decrypts the Self-Signing Key and verifies itself with a Green Shield 🛡️
# MATRIX_RECOVERY_KEY="EsTc jETz kP1Y 5Xcm NDs3 Gvp3 HkgQ SHz7 FPLJ x5D7 5z6S mv6y"

# Optional: Path to custom workspace directory (defaults to parent directory)
# DEFAULT_WORKSPACE=/path/to/antigravity-nexus

# Optional: Path to custom agy binary (auto-detected by default)
# AGY_BIN=/path/to/agy
